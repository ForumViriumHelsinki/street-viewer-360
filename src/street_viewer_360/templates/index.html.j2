<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{{ title }}</title>
  <link rel="stylesheet" href="assets/leaflet/leaflet.css" />
  <link rel="stylesheet" href="assets/pannellum/pannellum.css" />
  <link rel="stylesheet" href="assets/styles.css" />
</head>
<body>
  <header class="app-header">
    <div class="brand">
      <h1>{{ title }}</h1>
    </div>
    <div class="header-right">
      <div id="status" class="status"></div>
      {% if logos %}
      <div class="brand-logos" aria-label="Logos">
        {% for logo in logos %}
        <img class="brand-logo" src="{{ logo.src }}" alt="{{ logo.alt }}" />
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </header>

  <main class="app-main">
    <section id="map" class="map"></section>
    <section id="viewer" class="viewer hidden">
      <button id="viewer-close" class="viewer-close" type="button" aria-label="Close viewer">&times;</button>
      <button id="viewer-prev" class="viewer-nav viewer-prev" type="button" aria-label="Previous panorama">&#10094;</button>
      <button id="viewer-next" class="viewer-nav viewer-next" type="button" aria-label="Next panorama">&#10095;</button>
      <div id="viewer-info" class="viewer-info"></div>
      <div id="panorama" class="panorama"></div>
    </section>
  </main>

  <script src="assets/leaflet/leaflet.js"></script>
  <script src="assets/pannellum/pannellum.js"></script>
  <script src="assets/app.js"></script>
</body>
</html>
